# Local development values. Copy to a gitignored .env file or store equivalents in
# ASP.NET user secrets for Campaign.Api. Do not use these values in production.

ConnectionStrings__Campaign=Host=localhost;Port=5432;Database=campaign;Username=campaign;Password=campaign
Email__Provider=Smtp
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__FromAddress=campaign@localhost
Email__FromName=Campaign
Email__SmtpUsername=
Email__SmtpPassword=
Email__EnableSsl=false
Email__Resend__ApiKey=
PublicWeb__Origin=http://localhost:4200
Storage__RootPath=app-data
Database__ApplyMigrationsOnStartup=true
ForwardedHeaders__Enabled=false
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Facebook__AppId=
Authentication__Facebook__AppSecret=
Authentication__Discord__ClientId=
Authentication__Discord__ClientSecret=
